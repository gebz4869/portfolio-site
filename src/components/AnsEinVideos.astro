---
type VideoCard = {
	title: string;
	src: string;
	poster?: string;
	instagramUrl: string;
};

const videos: VideoCard[] = [
	{ title: 'Product Launch', src: '/videos/ans-ein/product-launch.mp4', instagramUrl: 'https://www.instagram.com/p/Da1AODUSUXe/' },
	{ title: 'Mini Vlog', src: '/videos/ans-ein/mini-vlog.mp4', instagramUrl: 'https://www.instagram.com/p/DaMb62eSul8/' },
	{ title: 'Product Demo', src: '/videos/ans-ein/product-demo.mp4', instagramUrl: 'https://www.instagram.com/p/DblLvTHyaL4/' },
];
---

<section class="ans-ein-videos" aria-label="Ans.Ein videos">
	<div class="ans-ein-videos__grid">
		{videos.map((video) => (
			<article class="ans-ein-videos__card">
				<h2 class="ans-ein-videos__title">{video.title}</h2>
				<video controls preload="metadata" playsinline poster={video.poster}>
					<source src={video.src} type="video/mp4" />
					Your browser does not support HTML video.
				</video>
				<a class="ans-ein-videos__link" href={video.instagramUrl} target="_blank" rel="noopener noreferrer">view on Instagram ↗</a>
			</article>
		))}
	</div>
</section>

<style>
	.ans-ein-videos {
		margin-top: clamp(48px, 7vw, 96px);
	}

	.ans-ein-videos__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
		gap: clamp(16px, 2.2vw, 32px);
	}

	.ans-ein-videos__card { min-width: 0; }

	.ans-ein-videos__title {
		min-height: 1.1em;
		margin: 0 0 clamp(18px, 2vw, 28px);
		font-family: var(--font-serif);
		font-size: var(--type-h3-size);
		font-weight: var(--type-h2-weight);
		letter-spacing: -0.055em;
		line-height: var(--type-h3-line);
		text-wrap: balance;
	}

	.ans-ein-videos__card video {
		display: block;
		width: 100%;
		height: auto;
		background: var(--color-ink);
	}

	.ans-ein-videos__link {
		display: inline-block;
		margin-top: 12px;
		color: var(--color-ink);
		font-size: var(--type-button-size);
		font-weight: var(--type-button-weight);
		line-height: var(--type-button-line);
		text-decoration-color: var(--color-sage);
		text-underline-offset: 4px;
	}

	.ans-ein-videos__link:hover { color: var(--color-sage); }

	@media (max-width: 900px) {
		.ans-ein-videos__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.ans-ein-videos__title { min-height: 2em; }
	}

	@media (max-width: 560px) {
		.ans-ein-videos__grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
		.ans-ein-videos__title { min-height: 0; font-size: var(--type-h3-size); line-height: var(--type-h3-line); }
	}
</style>
