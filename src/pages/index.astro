---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../lib/projects';

// Keep the homepage selection varied and stable while reading live Notion data.
const projectOrder = [
	'Double Take Branding',
	'RENEW Playbook',
	'Ans.Ein',
	'F***/FASH',
	'Photography Works',
];
const selectedProjects = [
	...projectOrder.flatMap((title) => projects.filter((project) => project.title === title && project.cover)),
	...projects.filter((project) => project.cover && !projectOrder.includes(project.title)),
].slice(0, 5);
---

<BaseLayout title="Portfolio — EG Graphic Design" description="Selected graphic design, editorial, campaign, and photography work by EG.">
	<main class="landing-page">
		<section class="landing-intro" aria-labelledby="intro-title">
			<div class="landing-intro__row">
				<img class="landing-intro__mark" src="/favicon.svg" alt="EG personal logo" />
				<div class="landing-intro__copy">
					<h1 id="intro-title">Welcome to my Portfolio!</h1>
					<p class="landing-intro__description">
						I’m a graphic designer working across brand identity, editorial, and digital content. I enjoy turning ideas into clear, thoughtful visual experiences.
					</p>
				</div>
			</div>
		</section>

		<section class="project-collage" aria-label="Selected portfolio projects">
			<div class="project-collage__row project-collage__row--lead">
				{selectedProjects.slice(0, 2).map((project) => (
					<a class="project-collage__item" href={`/work/${project.slug}/`} aria-label={`View ${project.title} project`}>
						<img src={project.cover} alt={`${project.title} — ${project.discipline.join(', ')} project`} loading="eager" />
						<span class="project-collage__overlay" aria-hidden="true">
							<span class="project-collage__title">{project.title}</span>
							{project.year && <span class="project-collage__year">{project.year}</span>}
						</span>
					</a>
				))}
			</div>
			<div class="project-collage__row project-collage__row--support">
				{selectedProjects.slice(2).map((project) => (
					<a class="project-collage__item" href={`/work/${project.slug}/`} aria-label={`View ${project.title} project`}>
						<img src={project.cover} alt={`${project.title} — ${project.discipline.join(', ')} project`} loading="lazy" />
						<span class="project-collage__overlay" aria-hidden="true">
							<span class="project-collage__title">{project.title}</span>
							{project.year && <span class="project-collage__year">{project.year}</span>}
						</span>
					</a>
				))}
			</div>
		</section>

		<section class="landing-closing" aria-label="Closing quotation">
			<blockquote>
				<p>How <em>beautiful</em> are the feet of those who brings <em>good news.</em> sdg</p>
			</blockquote>
		</section>
	</main>
</BaseLayout>

<style>
	:global(.site-shell) { width: min(calc(100% - 48px), 1440px); }
	:global(.site-header) { display: none; }

	.landing-page {
		--landing-ink: #282a25;
		--landing-serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
		padding: clamp(32px, 4.4vw, 52px) 0;
		color: var(--landing-ink);
	}

	.landing-intro {
		margin-inline: clamp(42px, 10.5vw, 112px);
		padding: clamp(20px, 2vw, 28px) 0 clamp(44px, 5vw, 64px);
	}

	.landing-intro__row {
		display: grid;
		grid-template-columns: clamp(130px, 18vw, 185px) minmax(0, 1fr);
		align-items: center;
		gap: clamp(28px, 3.2vw, 44px);
	}

	.landing-intro__mark {
		display: block;
		width: 100%;
		height: auto;
	}

	.landing-intro__copy { max-width: 920px; }

	.landing-intro h1 {
		margin: 0;
		font-family: var(--landing-serif);
		font-size: var(--type-h1-size);
		font-style: italic;
		font-weight: var(--type-h1-weight);
		letter-spacing: -0.075em;
		line-height: var(--type-h1-line);
		text-wrap: balance;
	}

	.landing-intro__description {
		max-width: 520px;
		margin: clamp(22px, 2.5vw, 32px) 0 0;
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
	}

	.project-collage { display: grid; gap: clamp(16px, 2.2vw, 30px); }

	.project-collage__row {
		display: grid;
		align-items: start;
		gap: clamp(14px, 2vw, 28px);
	}

	.project-collage__row--lead { grid-template-columns: 1fr 1fr; }
	.project-collage__row--support { grid-template-columns: repeat(3, minmax(0, 1fr)); }

	.project-collage__item {
		position: relative;
		display: block;
		min-width: 0;
		overflow: hidden;
		line-height: 0;
	}

	.project-collage__item img {
		display: block;
		width: 100%;
		height: auto;
		background: #efede7;
	}

	.project-collage__overlay {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: rgb(20 20 20 / 72%);
		color: #fff;
		line-height: 1.4;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.project-collage__title,
.project-collage__year {
    position: absolute;
    left: 50%;
    width: calc(100% - 32px);
    text-align: center;
    transform: translate(-50%, -50%);
}

.project-collage__title {
    top: 45%;
    font-family: var(--landing-serif);
    font-size: var(--type-h3-size);
    font-weight: var(--type-h3-weight);
    line-height: var(--type-h3-line);
    text-wrap: balance;
}

.project-collage__year {
    top: 55%;
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-line);
    letter-spacing: 0.1em;
}

	@media (hover: hover) and (pointer: fine) {
		.project-collage__item:hover .project-collage__overlay { opacity: 1; }
	}

	.project-collage__item:focus-visible .project-collage__overlay,
	.project-collage__item:active .project-collage__overlay { opacity: 1; }

	.project-collage__item:focus-visible {
		outline: 2px solid var(--landing-ink);
		outline-offset: 5px;
	}

	.landing-closing {
		display: grid;
		min-height: 0;
		place-items: center;
		padding: clamp(16px, 2.5vw, 28px) 0 0;
	}

	.landing-closing blockquote {
		width: min(100%, 700px);
		margin: 0;
		text-align: center;
	}

	.landing-closing blockquote p {
		margin: 0;
		font-family: var(--landing-serif);
    font-size: 28px;
    font-weight: var(--type-h3-weight);
		letter-spacing: -0.045em;
		line-height: 36px;
		text-wrap: balance;
		white-space: nowrap;
	}

	.landing-closing em { font-style: italic; font-weight: 400; }

	@media (max-width: 760px) {
		:global(.site-shell) { width: calc(100% - 40px); }
		.landing-page { margin-bottom: 20px; padding: 22px 0; }

		.landing-intro { margin-inline: 0; padding: 12px 0 40px; }
		.landing-intro__row {
			display: grid;
			grid-template-columns: clamp(68px, 19vw, 92px) minmax(0, 1fr);
			align-items: stretch;
			gap: clamp(12px, 4vw, 18px);
		}
		.landing-intro__copy { display: contents; }
		.landing-intro__mark {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		.landing-intro h1 {
			font-size: var(--type-h1-size);
			letter-spacing: -0.07em;
			line-height: var(--type-h1-line);
		}

		.landing-intro__description {
			grid-column: 1 / -1;
			max-width: 520px;
			margin-top: 22px;
			font-size: var(--type-body-size);
			line-height: var(--type-body-line);
		}

		.project-collage { gap: 22px; }
		.project-collage__row { grid-template-columns: 1fr; gap: 22px; }
		.project-collage__row--lead { margin-left: 0; }
		.project-collage__row .project-collage__item { width: 100%; justify-self: stretch; }
		.project-collage__overlay { background: rgb(20 20 20 / 62%); }
		.project-collage__title { top: 16px; font-size: var(--type-h3-size); line-height: var(--type-h3-line); }

		.landing-closing {
			min-height: 0;
			padding: 20px 0 0;
		}

		.landing-closing blockquote p {
			font-size: var(--type-h3-size);
			line-height: var(--type-h3-line);
			white-space: normal;
		}
	}

	@media (min-width: 761px) and (max-width: 1000px) {
		.landing-closing blockquote p { white-space: normal; }
	}

	@media (max-width: 380px) {
		.landing-page { padding-block: 18px; }
	}
</style>
